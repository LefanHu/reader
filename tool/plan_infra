#!/bin/sh
set -eu

# shellcheck source=tool/infra_common.sh
. "$(dirname -- "$0")/infra_common.sh"
check_tools
load_environment "$@"
prepare_workspace
gcloud auth application-default print-access-token >/dev/null 2>&1 || \
  die "Terraform needs Application Default Credentials; run gcloud auth application-default login"
gcloud storage buckets describe "gs://$STATE_BUCKET" --project="$STATE_PROJECT" >/dev/null 2>&1 || \
  die "remote state is not bootstrapped; run tool/deploy_backend $ENVIRONMENT --scope core"

terraform_init foundation "reader/$ENVIRONMENT/foundation"
assert_migrated
if [ "$SCOPE" != illustrations ]; then
  require_google_credentials
  prepare_apple_retirement
  if [ "$APPLE_RETIREMENT_REQUIRED" = true ]; then
    plan_apple_retirement
    printf '%s\n' "Review this Apple disable/protection transition first; deployment then removes only the retired provider."
  else
    plan_infrastructure foundation
  fi
fi
[ "$SCOPE" != core ] || exit 0
require_core
terraform_init illustrations "reader/$ENVIRONMENT/illustrations"
plan_infrastructure illustrations

# New installations can review infrastructure before a container exists.
if ! gcloud storage ls "gs://$STATE_BUCKET/reader/$ENVIRONMENT/runtime/default.tfstate" >/dev/null 2>&1; then
  printf '%s\n' "Runtime is not deployed; infrastructure plan complete. Deploy illustrations to build its first image."
  exit 0
fi
terraform_init runtime "reader/$ENVIRONMENT/runtime"
image=${IMAGE:-}
if [ -z "$image" ]; then
  image=$(terraform -chdir="$INFRA_DIR/runtime" output -raw image)
fi
[ -n "$image" ] || die "runtime has no deployed image; set IMAGE to an immutable Artifact Registry digest"
# Read-only discovery: planning never creates secret versions.
discover_image_provider_secrets
plan_infrastructure runtime -var="image=$image" -var-file="$IMAGE_PROVIDER_VARS"
